# ============================================================================
# 中橋季刊投稿系統 · 設定檔範本
# ----------------------------------------------------------------------------
# 用法：
#   1. 複製本檔為同目錄下的  secrets.toml
#   2. 只填你要用的區塊
#   3. secrets.toml 已被 .gitignore 排除，不會進版控
#
# 部署到 Streamlit Community Cloud 時不需上傳本檔，
# 改在  App → Settings → Secrets  貼上同樣內容即可。
#
# 各區塊都是「選填」，可任意搭配：
#   只填 [app]                → 投稿只存本機 submissions/ 資料夾
#   加 [drive]                → 每篇投稿的內文/照片/原檔存進你的 Google Drive 資料夾
#   加 [google] + [gcp_...]   → 投稿文字彙整成 Google Sheets 總表（方便一覽）
#   加 [email]                → 每筆投稿把全文與原照 email 給編輯部
# ============================================================================

[app]
admin_username = "lyf1228"
admin_password = "請改成你自己的強密碼"


# ---- Google Drive：把每篇投稿的檔案存進你的雲端硬碟資料夾 ----
# 需先部署 apps_script.gs（見 README「設定一：Google Drive」）
[drive]
webapp_url = "https://script.google.com/macros/s/AKfycb.../exec"
token = "和 Apps Script 裡 TOKEN 一字不差的通關密語"


# ---- Google Sheets：投稿文字總表（選用，方便一覽）----
[google]
sheet_url = "https://docs.google.com/spreadsheets/d/xxxxxxxxxxxxxxxxxxxxxxxxxxxxx/edit"
# sheet_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Google Cloud 服務帳戶金鑰（下載的 JSON 逐欄貼上，private_key 的 \n 要保留）
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...（保留每個 \\n 換行符）...\n-----END PRIVATE KEY-----\n"
client_email = "portal-bot@your-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
token_uri = "https://oauth2.googleapis.com/token"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/portal-bot%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"


# ---- 投稿通知信（Gmail SMTP，選用）----
[email]
sender = "lyf1228@gmail.com"
# Gmail「應用程式密碼」：Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼
app_password = "abcd efgh ijkl mnop"
recipients = ["lyf1228@gmail.com", "shon.yang@gmail.com"]
